{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.DS_Store",
      "**/.last_build_id",
      "**/.git/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/!(.well-known|onesignal|flutter_service_worker.js|app-update.json){,/**}",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/{,index.html,manifest.json,version.json,flutter_bootstrap.js,flutter.js,main.dart.js,flutter_service_worker.js}",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      },
      {
        "source": "/app-update.json",
        "headers": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"},
          {"key": "Pragma", "value": "no-cache"},
          {"key": "Expires", "value": "0"}
        ]
      },
      {
        "source": "/**/!(*.*)",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      },
      {
        "source": "/onesignal/**",
        "headers": [
          {"key": "Content-Type", "value": "application/javascript"},
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      },
      {
        "source": "/.well-known/**",
        "headers": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "naliv-web-test",
          "appId": "1:708777510505:android:617d39b5a388808bb604f8",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "naliv-web-test",
          "appId": "1:708777510505:ios:1ddb1b587f99a39eb604f8",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "naliv-web-test",
          "configurations": {
            "android": "1:708777510505:android:617d39b5a388808bb604f8",
            "ios": "1:708777510505:ios:1ddb1b587f99a39eb604f8",
            "web": "1:708777510505:web:1bafdcd9c3dd0a00b604f8"
          }
        }
      }
    }
  }
}
