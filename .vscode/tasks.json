{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Design: capture and compare both themes",
      "type": "shell",
      "command": "dart run tool/verify_surface.dart all --theme both",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Verify: integration and important regressions",
      "type": "shell",
      "command": "flutter test --concurrency=1",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Verify: analyze app, tests, and tools",
      "type": "shell",
      "command": "dart analyze lib test integration_test tool",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Verify: native shopping end-to-end",
      "type": "shell",
      "command": "flutter test integration_test/shopping_e2e_test.dart -d windows",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
